<?xml version="1.0" encoding="utf-8"?>
<!-- Notification / status bar icon: the DryWatch mark, single colour so the
     system can tint it (white on dark status bar, dark on light). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <!-- Outer rotated frame (diamond) -->
    <path
        android:pathData="M12,3.2 L20.8,12 L12,20.8 L3.2,12 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:fillColor="#00000000" />
    <!-- Inner rotated frame -->
    <path
        android:pathData="M12,7.6 L16.4,12 L12,16.4 L7.6,12 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:fillColor="#00000000" />
    <!-- Centre dot -->
    <path
        android:pathData="M12,10.6 a1.4,1.4 0 1,0 0.01,0 Z"
        android:fillColor="#FFFFFF" />
</vector>
